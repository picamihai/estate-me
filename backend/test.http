###

### GRAPHQL get properties
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query { properties { id title description price location status } }"
}

###

### GRAPHQL get property by ID with viewings
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query ($id: String!) { property(id: $id) { id title description price location status viewings { id propertyId date client status requestedByUsername } } }",
  "variables": {
    "id": "{{propertyId}}"
  }
}

###

### GRAPHQL stats
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query { stats { total totalValue average available sold } }"
}

###

### GRAPHQL create property as admin
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "query": "mutation ($title: String!, $description: String, $price: Int!, $location: String!, $status: String) { addProperty(title: $title, description: $description, price: $price, location: $location, status: $status) { id title description price location status } }",
  "variables": {
    "title": "GraphQL House",
    "description": "Created through GraphQL",
    "price": 180000,
    "location": "Groningen",
    "status": "AVAILABLE"
  }
}

###

### GRAPHQL create property as user - FAIL
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "query": "mutation { addProperty(title: \"Blocked GraphQL House\", price: 100000, location: \"Cluj\") { id } }"
}

###

### GRAPHQL update property as admin
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "query": "mutation ($id: String!) { updateProperty(id: $id, title: \"Updated GraphQL House\", description: \"Updated through GraphQL\", price: 190000, location: \"Cluj\", status: \"SOLD\") { id title description price location status } }",
  "variables": {
    "id": "{{propertyId}}"
  }
}

###

### GRAPHQL update property as user - FAIL
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "query": "mutation ($id: String!) { updateProperty(id: $id, title: \"Blocked Update\") { id title } }",
  "variables": {
    "id": "{{propertyId}}"
  }
}

###

### GRAPHQL delete property as admin
POST {{baseUrl}}/graphql
