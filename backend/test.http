@baseUrl = https://localhost:3000
@propertyId = paste-property-id-here
@viewingId = paste-viewing-id-here
@observationId = paste-observation-id-here

### LOGIN admin - step 1
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {%
    client.global.set("adminLoginSessionId", response.body.loginSessionId);
    client.global.set("adminCode", response.body.devCode);
%}

###

### VERIFY admin - step 2
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "loginSessionId": "{{adminLoginSessionId}}",
  "code": "{{adminCode}}"
}

> {%
    client.global.set("adminToken", response.body.token);
%}

###

### LOGIN normal user - step 1
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "user",
  "password": "user123"
}

> {%
    client.global.set("userLoginSessionId", response.body.loginSessionId);
    client.global.set("userCode", response.body.devCode);
%}

###

### VERIFY normal user - step 2
POST {{baseUrl}}/auth/login/verify
Content-Type: application/json

{
  "loginSessionId": "{{userLoginSessionId}}",
  "code": "{{userCode}}"
}

> {%
    client.global.set("userToken", response.body.token);
%}

###

### REGISTER new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "testuser123",
  "password": "testpass"
}

###

### FORGOT PASSWORD
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "username": "user"
}

> {%
    client.global.set("resetCode", response.body.devCode);
%}

###

### RESET PASSWORD
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "username": "user",
  "code": "{{resetCode}}",
  "newPassword": "user123"
}

###

### GET all properties
GET {{baseUrl}}/properties

###

### GET statistics
GET {{baseUrl}}/properties/statistics

###

### CREATE property as admin
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "New House",
  "description": "Nice place",
  "price": 100000,
  "location": "Cluj",
  "status": "AVAILABLE"
}

###

### CREATE property as normal user - FAIL
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "Blocked House",
  "description": "Should fail",
  "price": 100000,
  "location": "Cluj",
  "status": "AVAILABLE"
}

###

### CREATE property without token - FAIL
POST {{baseUrl}}/properties
Content-Type: application/json

{
  "title": "Blocked House",
  "description": "Should fail",
  "price": 100000,
  "location": "Cluj",
  "status": "AVAILABLE"
}

###

### CREATE property invalid as admin
POST {{baseUrl}}/properties
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "a",
  "price": -10,
  "location": ""
}

###

### GET property by ID existing
GET {{baseUrl}}/properties/{{propertyId}}

###

### GET property by ID not existing
GET {{baseUrl}}/properties/00000000-0000-0000-0000-000000000000

###

### UPDATE property as admin
PUT {{baseUrl}}/properties/{{propertyId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "Updated House",
  "description": "Updated desc",
  "price": 150000,
  "location": "Cluj",
  "status": "SOLD"
}

###

### UPDATE property as normal user - FAIL
PUT {{baseUrl}}/properties/{{propertyId}}
Content-Type: application/json
Authorization: Bearer {{userToken}}

{
  "title": "User Update",
  "description": "Should fail",
  "price": 150000,
  "location": "Cluj",
  "status": "SOLD"
}

###

### UPDATE property without token - FAIL
